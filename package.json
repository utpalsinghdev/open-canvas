{
  "name": "open-cavas",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.6.1",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "node scripts/runtime.mjs dev web",
    "check": "tsc --noEmit",
    "build": "pnpm run check && vite build",
    "preview": "node scripts/runtime.mjs main web",
    "dev:agent": "node scripts/runtime.mjs dev web",
    "mcp": "node scripts/runtime.mjs main mcp",
    "mcp:config": "node scripts/config.mjs main",
    "start": "node scripts/runtime.mjs main web",
    "release:main": "node scripts/release.mjs",
    "mcp:dev": "node scripts/runtime.mjs dev mcp",
    "mcp:config:dev": "node scripts/config.mjs dev",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:apply": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "service:install": "node scripts/install-main-service.mjs",
    "service:status": "systemctl --user status open-cavas-main.service --no-pager",
    "service:restart": "systemctl --user restart open-cavas-main.service"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "cssstyle": "^6.2.0",
    "lucide-react": "^0.468.0",
    "parse5": "^8.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/cssstyle": "^2.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
