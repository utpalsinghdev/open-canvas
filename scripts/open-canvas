#!/usr/bin/env bash
set -euo pipefail

command_path=$0
case $command_path in /*) ;; *) command_path=$PWD/$command_path ;; esac
launcher=$command_path
while [ -L "$launcher" ]; do
  target=$(readlink "$launcher")
  case $target in /*) launcher=$target ;; *) launcher=$(dirname "$launcher")/$target ;; esac
done
bundle=$(cd "$(dirname "$launcher")/.." && pwd -P)
export OPEN_CAVAS_COMMAND="$command_path"
exec "$bundle/bin/node" "$bundle/scripts/installed.mjs" "$@"
